# --- Base de datos Oracle ---
DB_HOST=localhost
DB_PORT=1521
DB_NAME=freepdb1
DB_USERNAME=admin
DB_PASSWORD=cambiar_esto

# --- RabbitMQ ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USUARIO=guest
RABBITMQ_CONTRASENA=guest

# --- Kafka (docker-compose.kafka.yml; dentro de la red: kafka-1:29092,kafka-2:29092,kafka-3:29092) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092,localhost:9093,localhost:9094

# --- Eureka ---
EUREKA_URL=http://localhost:8761/eureka/
EUREKA_IP=127.0.0.1
EUREKA_PORT=8082

# --- Servidor ---
PUERTO=8082
MODO_DEBUG=false

# --- Config Server (opcional, esquema http/https obligatorio) ---
CONFIG_SERVER_URL=http://localhost:8888
